{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "types": [
      "element-plus/global",
      "@types/node",
      "@nuxt/types"
    ],
    "baseUrl": ".",
    "paths": {
      "~/*": ["./*"],
      "@/*": ["./*"],
      "~~/*": ["./*"]  // 补充Nuxt常用别名
    }
  },
  "include": [
    "types/**/*.d.ts",
    "env.d.ts",
    ".nuxt/**/*.ts"  // 包含.nuxt生成文件
  ]
}
