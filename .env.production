# 说明：
# 1. 以 NUXT_PUBLIC_ 开头 → 会暴露到客户端（放不敏感的）
# 2. 以 NUXT_ 开头（但不是 NUXT_PUBLIC_）→ 仅服务端可见（放私密）

# OBS服务地址
NUXT_PUBLIC_OBS_URL=https://dafen-prod-media.artdafen.com
#NUXT_PUBLIC_OBS_URL=https://dafen-prod-media.obs.ap-southeast-1.myhuaweicloud.com
# 线上环境接口地址
NUXT_PUBLIC_API_BASE=https://artdafen.com/api
# Paypal客户ID
NUXT_PUBLIC_PAYPAL_CLIENT_ID=BAAOopA-3s2vb24XJjnOfFMubcM-ahiYYg-39a5J7iQM5qq1lCd9Lp-mpB7fy5CeuIpr2SL2agvJ_V8DkA
# 超时时间
NUXT_PUBLIC_HTTP_TIMEOUT=60000
# 站点域名
NUXT_PUBLIC_SITE_URL=https://artdafen.com
# 站点名称
NUXT_PUBLIC_SITE_NAME=ARTDAFEN
# 是否开启SSR
NUXT_PUBLIC_ENABLE_SSR=true