{"file":"_id_-DX0-3ts8.js","mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AA+DA,UAAA,QAAA,SAAA;AACA,cAAA;AACA,UAAA,KAAA,MAAA,MAAA,QAAA,IAAA;AAGA,UAAA,EAAA,MAAA,YAAA,SAAA,OAAA,QAAA,KAAA,CAAA,QAAA,SAAA,IAAAA,iBAAA,YAAA,aAAA,MAAA,eAAA,GAAA,KAAA,IAAA,YAAA;AACE,YAAA,SAAA,iBAAA;AACA,YAAA,EAAA,KAAA,IAAA,MAAA,OAAA,OAAA,OAAA,UAAA,eAAA,kBAAA,GAAA,KAAA;AACA,aAAA;AAAA,IAAO,GAAA;AAAA,MACN,QAAA;AAAA,MACO,SAAA,OAAA,CAAA;AAAA;AAAA,MACS,OAAA,CAAA,EAAA;AAAA,IAEP,CAAA,CAAA,GAAA,SAAA,MAAA,QAAA,UAAA,GAAA;AAIZ,UAAA,YAAA,SAAA,EAAA,IAAA,IAAA,YAAA,IAAA,MAAA,GAAA;AAGA,UAAA,MAAA,WAAA,OAAA,CAAA,WAAA;AACE,UAAA,QAAA;AACE,eAAA,UAAA,OAAA,QAAA,QAAA,8CAAA,CAAA,OAAA,IAAA,IAAA,OAAA;AACE,iBAAA,GAAA,EAAA,GAAA,YAAA,EAAA,CAAA;AAAA,QAA8B,CAAA;AAEhC,kBAAA,KAAA,OAAA;AACA,kBAAA,aAAA,OAAA;AAAA,MAA8B;AAAA,IAChC,GAAA,EAAA,WAAA,MAAA;;;;AA7EiC,UAAAC,MAAA,UAAA,EAAA,IAAA;;;;;;;;;;;;;;;;;;","names":["_withAsyncContext","_unref"],"sources":["../../../../pages/news-detail/[id].vue"],"sourcesContent":["<template>\r\n  <section class=\"news-detail\">\r\n    <div class=\"container-small\">\r\n\r\n      <div class=\"text-40 f-bold my-20\"> {{ newsDetail.title }}</div>\r\n\r\n      <div class=\"text-12 my-20\">{{ formatTimestamp(newsDetail.createTime, 'YYYY-MM-DD HH:mm:ss') }}</div>\r\n\r\n      <div v-html=\"newsDetail.content\"/>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- 推荐新闻 -->\r\n  <section class=\"news-more\" v-if=\"newsDetail.id\">\r\n    <div class=\"container-small\">\r\n      <h1 class=\"my-md-40 my-20 py-20 border-b-xl border-gray-700 text-26 font-bold\">RECOMMEND</h1>\r\n      <ClientOnly>\r\n        <ProInfinite\r\n          ref=\"proInfiniteRef\"\r\n          :request-api=\"getNewsRecommend\"\r\n          :init-param=\"initParam\"\r\n        >\r\n          <template #default=\"scope\">\r\n            <div class=\"news-more-list\">\r\n              <div class=\"news-more-item acea-row row-between gap-row-base cursor-pointer\" v-for=\"item in scope.rows\" :key=\"item.id\" @click=\"router.replace(`/news-detail/${item.id}`)\">\r\n                <div class=\"p-cont\">\r\n                  <div>\r\n                    <p class=\"text-26 line2\">{{ item.title }}</p>\r\n                    <p class=\"text-16 my-10 line2\">{{ item.subtitle }}</p>\r\n                  </div>\r\n                  <div class=\"acea-row row-between-wrapper\">\r\n                    <div class=\"acea-row row-middle gap-xs\">\r\n                      <el-tag type=\"info\" effect=\"plain\" v-for=\"label in item.labels\" :key=\"label\">{{ label }}</el-tag>\r\n                    </div>\r\n                    <span class=\"text-14\">{{ formatTimestamp(item.createTime, 'YYYY.MM.DD') }}</span>\r\n                  </div>\r\n                </div>\r\n                <div class=\"p-img overflow-hidden\">\r\n                  <img class=\"w-full h-full fit-cover img-hover aspect-ratio-16_9\" :src=\"imagePrefix(item.img)\" alt=\"\">\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </template>\r\n        </ProInfinite>\r\n      </ClientOnly>\r\n    </div>\r\n  </section>\r\n\r\n</template>\r\n\r\n<script setup lang=\"ts\">\r\nimport {getNewsRecommendApi} from \"~/api/modules/news/news\";\r\nimport {formatTimestamp} from \"~/utils/format\";\r\nimport type {INews} from \"~/api/interface/news/news\";\r\nimport {imagePrefix} from \"~/utils\";\r\nimport ProInfinite from \"~/components/ProInfinite.vue\";\r\nimport type {IResultData} from \"~/api/interface\";\r\nimport {TRADE_MODULE} from \"~/api/helper/prefix\";\r\n\r\ndefineOptions({\r\n  name: 'NewsDetail',\r\n})\r\n\r\nconst route = useRoute()\r\nconst router = useRouter()\r\nconst id = toRef(route.params, 'id') // 响应式拿 id\r\n\r\n// 新闻详情\r\nconst { data: newsDetail, pending, error, refresh } = await useAsyncData(() => `news-detail-${id.value}`, async () => {\r\n  const config = useRuntimeConfig()\r\n  const {data} = await $fetch<IResultData<INews.Row>>(config.public.apiBase + TRADE_MODULE + '/news/detail/' + id.value)\r\n  return data\r\n}, {\r\n  server: true,\r\n  default: () => ({} as INews.Row),\r\n  // 当 id 变化时，自动重新执行（客户端）\r\n  watch: [id],\r\n})\r\n\r\n// 更多新闻\r\nconst initParam = reactive({id: '', categoryId: '', size: 5});\r\nconst getNewsRecommend = (params: INews.RecQuery) => getNewsRecommendApi(params)\r\n\r\nwatch(() => newsDetail.value, (newVal) => {\r\n  if (newVal) {\r\n    newVal.content = newVal.content.replace(/(<(img|video)[^>]*src=\")(?!http)([^\"]+\")/gi, (match, p1, p2, p3) => {\r\n      return `${p1}${imagePrefix(p3)}`;\r\n    });\r\n    initParam.id = newVal.id\r\n    initParam.categoryId = newVal.categoryId\r\n  }\r\n}, { immediate: true })\r\n\r\n</script>\r\n\r\n<style scoped lang=\"scss\">\r\n.news-more {\r\n  .news-more-list {\r\n    .news-more-item {\r\n\r\n      .p-cont {\r\n        width: 68%;\r\n        display: flex;\r\n        flex-direction: column;\r\n        justify-content: space-between;\r\n      }\r\n\r\n      .p-img {\r\n        flex-shrink: 0;\r\n        width: 30%;\r\n      }\r\n    }\r\n\r\n    .news-more-item + .news-more-item {\r\n      margin-top: var(--gutter-base);\r\n      padding-top: var(--gutter-base);\r\n      border-top: var(--border-width-sm) solid var(--color-gray-200);\r\n    }\r\n  }\r\n}\r\n\r\n@media (max-width: 768px) {\r\n  .news-more {\r\n    .news-more-list {\r\n      .news-more-item {\r\n\r\n        .p-cont {\r\n          order: 2;\r\n          width: 100%;\r\n          display: flex;\r\n          flex-direction: column;\r\n          justify-content: space-between;\r\n\r\n        }\r\n\r\n        .p-img {\r\n          order: 1;\r\n          flex-shrink: 0;\r\n          width: 100%;\r\n        }\r\n      }\r\n    }\r\n  }\r\n}\r\n</style>"],"version":3}