{"file":"account-Dk0vAFS0.js","mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;AAgGA,MAAA,WAAA;;;;;;;;AAzBA,YAAA;AACA,UAAA,YAAA,aAAA;AACA,cAAA;AACA,UAAA,QAAA,SAAA;AAUA,UAAA,WAAA;AAAA,MAAiB,EAAA,MAAA,wBAAA,MAAA,iBAAA,MAAA,mBAAA;AAAA,MAC+D,EAAA,MAAA,aAAA,MAAA,cAAA,MAAA,kBAAA;AAAA,MACf,EAAA,MAAA,gBAAA,MAAA,eAAA,MAAA,qBAAA;AAAA,MACO,EAAA,MAAA,oBAAA,MAAA,iBAAA,MAAA,qBAAA;AAAA;AAAA,IACM;AAI9E,UAAA,eAAA,SAAA,MAAA,MAAA,IAAA;AAGA,UAAA,WAAA,CAAA,cAAA,aAAA,aAAA,YAAA;AAEA,UAAA,WAAA,IAAA,EAAA;AACA,UAAA,gBAAA,IAAA;AAMA,UAAA,eAAA,CAAA,YAAA;AACE,YAAA,UAAA,QAAA,OAAA,OAAA,OAAA;AACA,YAAA,UAAA,SAAA,SAAA,QAAA,IAAA;AACA,UAAA,CAAA,QAAc,WAAA,QAAA,6DAAA;AACd,UAAA,CAAA,QAAc,WAAA,QAAA,gDAAA,QAAA,KAAA;AACd,aAAA,WAAA;AAAA,IAAkB;AAMpB,UAAA,eAAA,CAAA,SAAA;AACE,eAAA,QAAA,IAAA,gBAAA,KAAA,GAAA;AACA,oBAAA,OAAA,KAAA;AAAA,IAA0B;;;;;;;;QA9GV,QAAA,SAAA,KAAA,GAAA;AAAA,QACgB,iBAAA;AAAA,QACN,aAAA;AAAA,QACJ,eAAA;AAAA,QACE,kBAAA;AAAA,MACG,GAAA;AAAA;;;;;;gBAEUA,eAAAC,YAAA,OAAA;AAAA,kBAMxB,OAAA;AAAA,kBAJO,KAAAC,MAAA,SAAA,EAAA,SAAA;AAAA,kBACmB,KAAA;AAAA,gBACrB,GAAA,MAAA,GAAA,CAAA,KAAA,CAAA,GAAA;AAAA;gBAC6B,CAAA;AAAA;kBAEYD,YAAA,QAAA,EAAA,OAAA,iCAAA,CAAA;AAAA,gBACD,CAAA;AAAA;;;;;;;AAcjCE,oBAAA,UAAA,CAAA,SAAA;;;;;;;;;;;;;;;;;;","names":["_withDirectives","_createVNode","_unref","_ssrRenderList"],"sources":["../../../../pages/account.vue"],"sourcesContent":["<template>\r\n  <div class=\"container\">\r\n    <h1 class=\"text-40 f-bold-500 py-50\">MY PAGE</h1>\r\n    <div class=\"account-container acea-row row-between row-top\">\r\n      <div class=\"account-panel shadow-lg\">\r\n        <div class=\"account-info acea-row row-middle p-20 border-b-sm border-gray-200\">\r\n          <el-upload\r\n            class=\"mr-16\"\r\n            :accept=\"fileType.join(',')\"\r\n            :before-upload=\"beforeUpload\"\r\n            :on-change=\"uploadChange\"\r\n            :auto-upload=\"false\"\r\n            :show-file-list=\"false\"\r\n          >\r\n            <div class=\"account-avatar\">\r\n              <img\r\n                class=\"w-full h-full fit-cover rounded-full\"\r\n                :src=\"userStore.userInfo.avatar\"\r\n                alt=\"avatar\"\r\n                v-show=\"userStore.userInfo.avatar\"\r\n              >\r\n              <div class=\"camera acea-row row-center-wrapper\">\r\n                <span class=\"iconfont icon-camera-switching\"/>\r\n              </div>\r\n            </div>\r\n          </el-upload>\r\n          <div class=\"flex-1 overflow-hidden\">\r\n            <p class=\"text-14\">Hello 👋 </p>\r\n            <p class=\"text-18 f-bold mt-5 line1\">{{ userStore.userInfo.nickname }} </p>\r\n          </div>\r\n        </div>\r\n        <div class=\"account-menu my-lg-20 my-15\">\r\n          <div\r\n            class=\"account-item acea-row row-middle py-15 px-20 cursor-pointer\"\r\n            :class=\"{ 'on': currentRoute === menu.path }\"\r\n            @click=\"router.replace(menu.path)\"\r\n            v-for=\"menu in menuList\"\r\n            :key=\"menu.path\"\r\n          >\r\n            <span :class=\"`iconfont ${menu.icon} text-24`\"></span>\r\n            <span class=\"text-16 ml-12\">{{ menu.name }}</span>\r\n          </div>\r\n          <div class=\"account-item acea-row row-middle py-16 px-20 cursor-pointer\" @click=\"logout\">\r\n            <span class=\"iconfont icon-money-wallet text-24\"></span>\r\n            <span class=\"text-16 ml-12\">Log Out</span>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <div class=\"account-page flex-1\">\r\n        <NuxtPage/>\r\n      </div>\r\n    </div>\r\n  </div>\r\n  <ClientOnly>\r\n    <ImgCropper ref=\"imgCropperRef\" :src=\"imageUrl\" @cropper-success=\"cropperSuccess\"/>\r\n  </ClientOnly>\r\n</template>\r\n\r\n<script setup lang=\"ts\">\r\nimport {useUserStore} from \"~/stores/modules/user\";\r\nimport {useAuth} from \"~/composables/useAuth\";\r\nimport {useHandleData} from \"~/composables/useHandleData\";\r\nimport ImgCropper from '~/components/ImgCropper.vue'\r\nimport type {UploadFile, UploadProps} from \"element-plus\";\r\nimport {ElMessage} from \"element-plus\";\r\nimport {uploadAvatar} from \"~/api/modules/mine/mine\";\r\n\r\ndefineOptions({\r\n  name: 'Account'\r\n})\r\n\r\nconst {logoutFn} = useAuth();\r\nconst userStore = useUserStore();\r\nconst router = useRouter();\r\nconst route = useRoute();\r\n\r\nconst logout = () => {\r\n  useHandleData(\r\n    logoutFn,\r\n    {},\r\n    'Are you sure to log out?'\r\n  )\r\n}\r\n\r\nconst menuList = [\r\n  {name: 'Personal Information', icon: 'icon-customer', path: '/account/profile'},\r\n  {name: 'My Orders', icon: 'icon-goods', path: '/account/orders'},\r\n  {name: 'My Wishlists', icon: 'icon-follow', path: '/account/favorites'},\r\n  {name: 'Manage Addresses', icon: 'icon-location', path: '/account/addresses'},\r\n  // {name: 'Saved Cards', icon: 'icon-money-wallet', path: '/account/payments'},\r\n]\r\n\r\nconst currentRoute = computed(() => route.path);\r\n\r\n// 允许上传的文件类型\r\nconst fileType = ['image/webp', 'image/png', 'image/jpg', 'image/jpeg']\r\nconst fileSize = 15\r\nconst imageUrl = ref('')\r\nconst imgCropperRef = ref<InstanceType<typeof ImgCropper>>()\r\n\r\n/**\r\n * @description 文件上传之前判断\r\n * @param rawFile 选择的文件\r\n * */\r\nconst beforeUpload: UploadProps['beforeUpload'] = rawFile => {\r\n  const imgSize = rawFile.size / 1024 / 1024 < fileSize;\r\n  const imgType = fileType.includes(rawFile.type);\r\n  if (!imgType) ElMessage.warning('The uploaded image does not conform to the required format!');\r\n  if (!imgSize) ElMessage.warning(`The size of the uploaded image cannot exceed ${fileSize}MB！`);\r\n  return imgType && imgSize;\r\n};\r\n\r\n/**\r\n * @description 监听图片上传\r\n * */\r\nconst uploadChange = (file: UploadFile) => {\r\n  imageUrl.value = URL.createObjectURL(file.raw as Blob); // 把 File 转成 临时路径\r\n  imgCropperRef.value?.open()\r\n}\r\n\r\n/**\r\n * @description 裁切成功回调\r\n * */\r\nconst cropperSuccess = async (file: File) => {\r\n  const formData = new FormData();\r\n  formData.append('file', file)\r\n  await uploadAvatar(formData)\r\n  await userStore.getUserEcho()\r\n}\r\n\r\n</script>\r\n\r\n<style scoped lang=\"scss\">\r\n.account-container {\r\n\r\n  .account-panel {\r\n    width: 262px;\r\n    margin-right: 30px;\r\n\r\n    .account-info {\r\n      .account-avatar {\r\n        width: 51px;\r\n        height: 51px;\r\n        position: relative;\r\n\r\n        .camera {\r\n          position: absolute;\r\n          inset: 0;\r\n          border-radius: 50%;\r\n          background: rgba(0,0,0, 0.6);\r\n          color: #fff;\r\n          transition: all 0.3s ease-in-out;\r\n          opacity: 0;\r\n        }\r\n\r\n        &:hover {\r\n          .camera {\r\n            opacity: 1;\r\n          }\r\n        }\r\n      }\r\n    }\r\n\r\n    .account-menu {\r\n      .account-item.on {\r\n        background: var(--color-primary);\r\n        color: #ffffff;\r\n      }\r\n    }\r\n\r\n  }\r\n\r\n  .account-page {\r\n\r\n  }\r\n}\r\n\r\n\r\n@media (max-width: 1259px) {\r\n  .account-container .account-panel {\r\n    margin-right: 15px;\r\n  }\r\n}\r\n\r\n@media (max-width: 991px) {\r\n  .account-container {\r\n    .account-panel {\r\n      width: 100%;\r\n      margin-bottom: 15px;\r\n      margin-right: 0;\r\n    }\r\n  }\r\n}\r\n</style>"],"version":3}