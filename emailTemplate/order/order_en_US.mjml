<mjml>
    <mj-head>
        <mj-attributes>
            <mj-all font-family="Roboto, Arial, sans-serif" />
            <mj-text padding="0" />
            <mj-button border-radius="2px" font-weight="500" />
            <mj-section padding="0" />
            <mj-column padding="0" />
        </mj-attributes>

        <mj-font name="Roboto" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;900&display=swap" />
        <mj-preview>Your order has been confirmed - ARTDAFEN.COM</mj-preview>

        <mj-style inline="inline">
            .title {
            font-size: 22px;
            font-weight: 900;
            letter-spacing: 1px;
            color: #000000;
            }
            .text-muted {
            color: #808080;
            }
            .order-box {
            border: 1px solid #E6E6E6;
            border-radius: 2px;
            padding: 12px 18px;
            text-align: center;
            font-size: 18px;
            letter-spacing: 2px;
            background-color: #ffffff;
            color: #808080;
            }
            .footer-link {
            color: #34AFFF;
            }
        </mj-style>
    </mj-head>

    <mj-body background-color="#f5f5f5">
        <!-- === Main Container === -->
        <mj-section background-color="#f5f5f5" padding="24px 0">
            <mj-column width="500px" background-color="#ffffff" border-radius="2px" padding="0">

                <!-- === Header / Brand === -->
                <mj-section background-color="#ffffff" padding="20px 0">
                    <mj-column>
                        <mj-text align="center" font-size="30px" font-weight="900" letter-spacing="4px" color="#000000">
                            <a href="https://www.artdafen.com/" style="color:#000000; text-decoration:none;">ARTDAFEN.COM</a>
                        </mj-text>
                    </mj-column>
                </mj-section>

                <!-- === Logo === -->
                <mj-section background-color="#ffffff">
                    <mj-column>
                        <mj-image
                                src="https://dafen-prod-media.obs.ap-southeast-1.myhuaweicloud.com/static/logo.png"
                                width="60px"
                                alt="ART DAFEN Logo"
                                align="center"
                        />
                    </mj-column>
                </mj-section>

                <!-- === Order Title === -->
                <mj-section background-color="#ffffff" padding="20px 0">
                    <mj-column>
                        <mj-text align="center" font-size="20px" font-weight="900" letter-spacing="1px" color="#000000">
                            Your order is confirmed
                        </mj-text>
                    </mj-column>
                </mj-section>

                <!-- === Order Number === -->
                <mj-section background-color="#ffffff" padding="0 20px">
                    <mj-column>
                        <mj-text font-size="16px" font-weight="400" color="#000000" align="center" padding="0 0 6px">
                            Order Number
                        </mj-text>
                        <mj-text align="center">
                            <div class="order-box">FEADV</div>
                        </mj-text>
                    </mj-column>
                </mj-section>

                <!-- === Message === -->
                <mj-section background-color="#ffffff" padding="20px">
                    <mj-column>
                        <mj-text font-size="16px" line-height="1.6" color="#000000" align="center">
                            Thanks for shopping! Your order hasn't shipped yet, but we’ll send you an email once it’s on the way.
                        </mj-text>
                    </mj-column>
                </mj-section>

                <!-- === Primary Button: View Order === -->
                <mj-section background-color="#ffffff">
                    <mj-column>
                        <mj-button
                                width="100%"
                                href="https://www.artdafen.com/order-detail/2510155231900f13lvho5h9mo"
                                background-color="#000000"
                                color="#ffffff"
                                border-radius="2px"
                                font-size="16px"
                                inner-padding="16px 10px"
                                align="center"
                        >
                            View Order
                        </mj-button>
                    </mj-column>
                </mj-section>

                <!-- === Secondary Button: Back to Home === -->
                <mj-section background-color="#ffffff">
                    <mj-column>
                        <mj-button
                                width="100%"
                                href="https://www.artdafen.com/"
                                background-color="#ffffff"
                                color="#000000"
                                border="1px solid #000000"
                                border-radius="2px"
                                font-size="16px"
                                inner-padding="16px 10px"
                                align="center"
                        >
                            Back to Home
                        </mj-button>
                    </mj-column>
                </mj-section>

                <!-- === Footer === -->
                <mj-section background-color="#ffffff" padding="20px 20px">
                    <mj-column>
                        <mj-text align="center" font-size="12px" font-weight="700" letter-spacing="0.6px" color="#000000">
                            <a href="https://www.artdafen.com/" class="footer-link">ARTDAFEN.COM</a> – The Global Hub of Oil Painting in China
                        </mj-text>
                    </mj-column>
                </mj-section>

            </mj-column>
        </mj-section>
    </mj-body>
</mjml>
