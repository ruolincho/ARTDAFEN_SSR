<mjml>
    <mj-head>
        <mj-attributes>
            <mj-all font-family="Roboto, Arial, Helvetica, sans-serif" color="#000000" />
            <mj-text font-size="16px" />
            <mj-section padding="0" />
            <mj-column padding="0" />
        </mj-attributes>
    </mj-head>

    <mj-body background-color="#ffffff">
        <mj-section>
            <mj-column width="600px" padding="40px 0" border="1px solid #E6E6E6">
                <!-- Logo -->
                <mj-image src="https://dfs.artdafen.com/static/logo2.png" alt="ART DAFEN" width="265px" height="60px" align="center" />

                <!-- Title -->
                <mj-text align="center" font-size="34px" font-weight="bold" padding="30px 0">
                    Extra 15% Off All Orders
                </mj-text>

                <!-- Date -->
                <mj-text align="center" font-size="20px" font-weight="bold" text-transform="capitalize" padding="0 0 24px">
                    7 Day Only - Jun 23 - Nov 2 HKT
                </mj-text>

                <!-- Coupon + Button in the SAME dashed box -->
                <mj-text align="center" padding="0">
                    <!-- start inline dashed group -->
                    <mj-raw>
                        <div style="display:inline-block; border:1px dashed rgba(0,0,0,0.3); border-radius:8px; padding:6px;">
                            <table role="presentation" cellspacing="0" cellpadding="0" style="border-collapse:collapse;">
                                <tr>
                                    <td style="padding:10px 16px; font-weight:700; font-size:28px; letter-spacing:0.5px; text-transform:uppercase;">
                                        GETDER
                                    </td>
                                    <td style="padding:6px 6px 6px 8px;">
                                        <a href="https://artdafen.com"
                                           style="display:inline-block; background:#000000; color:#ffffff; text-decoration:none; font-weight:700; font-size:16px; line-height:18px; padding:12px 16px; border-radius:6px;">
                                            Activate &#8594;
                                        </a>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </mj-raw>
                    <!-- end inline dashed group -->
                </mj-text>

                <!-- Banner -->
                <mj-image src="https://dfs.artdafen.com/static/coupon_mail_bg.png" alt="Banner" padding="30px 0" />

                <!-- About -->
                <mj-text align="center" font-size="16px" font-weight="bold" padding="0 0 12px">
                    About ArtDafen.com
                </mj-text>
                <mj-text align="center" font-size="17px" padding="0 26px 10px">
                    ArtDafen.com offers curated wall art to help you express your personal style and bring your space to life. From timeless classics to modern photography and emerging artists, we make it easy to discover art that resonates with you. Whether you're creating a gallery wall, updating a room, or finding the perfect gift, our wide selection and custom framing options let you create something uniquely yours. With fast shipping and new collections added regularly, ArtDafen.com is your destination for art that reflects the art of you.
                </mj-text>
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>
