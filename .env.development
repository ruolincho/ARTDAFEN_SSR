# 说明：
# 1. 以 NUXT_PUBLIC_ 开头 → 会暴露到客户端（放不敏感的）
# 2. 以 NUXT_ 开头（但不是 NUXT_PUBLIC_）→ 仅服务端可见（放私密）

# OBS服务地址
NUXT_PUBLIC_OBS_URL=https://dafen-test-media.obs.cn-south-1.myhuaweicloud.com
# 线上环境接口地址
NUXT_PUBLIC_API_BASE=http://192.168.68.168:40000/api
#NUXT_PUBLIC_API_BASE=https://test.artdafen.com/api
# Paypal客户ID
NUXT_PUBLIC_PAYPAL_CLIENT_ID=AbxvpLu8klor2QTfCVOA1ZREmDWqG6zzejog1UjXSf_qL201R8Y5-8CMqfEthp6wxHBZbF2bBIVl9C20
# 超时时间
NUXT_PUBLIC_HTTP_TIMEOUT=60000
# 站点域名
NUXT_PUBLIC_SITE_URL=http://192.168.68.123:5174
# 站点名称
NUXT_PUBLIC_SITE_NAME=ART DAFEN_TEST